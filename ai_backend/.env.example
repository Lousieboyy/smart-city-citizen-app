# Smart City App — Default configuration for local development.
# Copy this file to .env and fill in production values.
# NEVER commit .env to version control.

DATABASE_URL=postgresql+psycopg2://postgres:YOUR_SECURE_PASSWORD@localhost/smart_city_db

# ─────────────────────────────────────────────────────────────
#  AI DATASET STORAGE
# ─────────────────────────────────────────────────────────────
# Collected training images are committed to a GitHub repo, because this backend
# runs on a read-only serverless filesystem where nothing written to disk
# survives a redeploy or cold start (true on every Vercel plan tier).
#
# The repo MUST be private: citizen reports contain faces, vehicles and the
# locations of people's homes and workplaces.
#
# Token needs 'contents: read and write' on that one repo only
# (a fine-grained PAT is preferred over a classic one).
GITHUB_TOKEN=
DATASET_REPO=your-username/smart-city-dataset
DATASET_BRANCH=main

# How many samples to bundle into a single commit.
DATASET_SYNC_BATCH_SIZE=25
